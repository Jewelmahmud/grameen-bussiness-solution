<Application x:Class="GrameenPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:GrameenPOS.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Custom Color Scheme: Purple to Blue Gradient -->
            <!-- rgb(94, 53, 177) = #5e35b1 (Purple) -->
            <!-- rgb(30, 136, 229) = #1e88e5 (Blue) -->
            <!-- Gradient: 45deg, purple 30%, blue 90% -->
            
            <!-- Primary Gradient Brush (45 degrees) -->
            <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5e35b1" Offset="0.3"/>
                <GradientStop Color="#1e88e5" Offset="0.9"/>
            </LinearGradientBrush>
            
            <!-- Primary Color Brushes -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#1e88e5"/>
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#5e35b1"/>
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#4527a0"/>
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF"/>
            
            <!-- Override Material Design Primary Color Brushes -->
            <SolidColorBrush x:Key="MaterialDesignPrimary" Color="#5e35b1"/>
            <SolidColorBrush x:Key="MaterialDesignPrimaryForeground" Color="#FFFFFF"/>
            
            <!-- Additional Color Resources -->
            <SolidColorBrush x:Key="BackgroundLightBrush" Color="#f5f5f5"/>
            <SolidColorBrush x:Key="BackgroundMediumBrush" Color="#e3f2fd"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#90caf9"/>
            <SolidColorBrush x:Key="BorderLightBrush" Color="#bbdefb"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5e35b1"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#90a4ae"/>
            <SolidColorBrush x:Key="ButtonDarkBlueBrush" Color="#002455"/>
            <SolidColorBrush x:Key="ResetButtonBrush" Color="#d90f59"/>
            <SolidColorBrush x:Key="OkButtonBrush" Color="#32a846"/>
            
            <!-- Font Family - Will use custom Bangla font if available, fallback to system fonts -->
            <FontFamily x:Key="BanglaFontFamily">
                <!-- This will be set dynamically in code-behind, but you can also set it here -->
                <!-- Example: ./#Kalpurush or ./#Siyam Rupali (replace with your font name) -->
                Segoe UI, Arial Unicode MS, Nirmala UI
            </FontFamily>
            
            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />
            <converters:DecimalToVisibilityConverter x:Key="DecimalToVisibilityConverter" />
            <converters:DiscountTypeToVisibilityConverter x:Key="DiscountTypeToVisibilityConverter" />
            <converters:DiscountTypeHintConverter x:Key="DiscountTypeHintConverter" />
            <converters:LocalizationConverter x:Key="LocalizationConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

