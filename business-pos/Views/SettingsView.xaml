<UserControl x:Class="GrameenPOS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar with Back Button -->
        <Border Grid.Row="0" 
               Background="{DynamicResource PrimaryGradientBrush}" 
               Padding="20,10"
               Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                       Command="{Binding NavigateBackCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       Foreground="White"
                       Margin="0,0,20,0">
                    <Button.ToolTip>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Back">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button>
                
                <TextBlock Grid.Column="1"
                          FontSize="24" 
                          FontWeight="Bold"
                          FontFamily="{DynamicResource BanglaFontFamily}"
                          Foreground="White"
                          VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Settings">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="30" MaxWidth="800">
            
            <!-- Login Background Image Section -->
            <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                   BorderThickness="1" 
                   CornerRadius="5" 
                   Padding="20"
                   Margin="0,0,0,20"
                   Background="White">
                <StackPanel>
                    <TextBlock FontSize="18" 
                              FontWeight="Bold"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,15">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="LoginBackground">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <TextBlock FontSize="14"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,10">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="SelectBackgroundImage">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0"
                                Text="{Binding SelectedBackgroundImage, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                IsReadOnly="True"
                                Margin="0,0,10,0"/>
                        
                        <Button Grid.Column="1"
                               Command="{Binding SelectBackgroundImageCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               FontFamily="{DynamicResource BanglaFontFamily}">
                            <Button.Content>
                                <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Select">
                                    <Binding Path="Language" />
                                </MultiBinding>
                            </Button.Content>
                        </Button>
                    </Grid>
                    
                    <TextBlock Text="{Binding SelectedBackgroundImage}"
                              FontSize="12"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              TextWrapping="Wrap"
                              Visibility="{Binding SelectedBackgroundImage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
            
            <!-- Overlay Settings Section -->
            <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                   BorderThickness="1" 
                   CornerRadius="5" 
                   Padding="20"
                   Margin="0,0,0,20"
                   Background="White">
                <StackPanel>
                    <TextBlock FontSize="18" 
                              FontWeight="Bold"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,15">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="OverlayColorSettings">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <!-- Overlay Color Start -->
                    <TextBlock FontSize="14"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,5">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="StartColor">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding OverlayColorStart, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                materialDesign:HintAssist.Hint="#RRGGBBAA (Hex color)"/>
                        <Border Grid.Column="1"
                               Width="40"
                               Height="40"
                               Margin="10,0,0,0"
                               BorderBrush="{DynamicResource BorderLightBrush}"
                               BorderThickness="1"
                               Background="{Binding OverlayColorStart, Converter={StaticResource StringToColorConverter}}"/>
                    </Grid>
                    
                    <!-- Overlay Color End -->
                    <TextBlock FontSize="14"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,5">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="EndColor">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding OverlayColorEnd, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                materialDesign:HintAssist.Hint="#RRGGBBAA (Hex color)"/>
                        <Border Grid.Column="1"
                               Width="40"
                               Height="40"
                               Margin="10,0,0,0"
                               BorderBrush="{DynamicResource BorderLightBrush}"
                               BorderThickness="1"
                               Background="{Binding OverlayColorEnd, Converter={StaticResource StringToColorConverter}}"/>
                    </Grid>
                    
                    <!-- Overlay Opacity -->
                    <TextBlock FontSize="14"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,5">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Opacity">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Value="{Binding OverlayOpacity}"
                           Minimum="0"
                           Maximum="1"
                           TickFrequency="0.1"
                           IsSnapToTickEnabled="True"
                           Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding OverlayOpacity, StringFormat='{}{0:P0}'}"
                              FontSize="12"
                              HorizontalAlignment="Right"
                              Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
            
            <!-- Tax Settings Section -->
            <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                   BorderThickness="1" 
                   CornerRadius="5" 
                   Padding="20"
                   Margin="0,0,0,20"
                   Background="White">
                <StackPanel>
                    <TextBlock FontSize="18" 
                              FontWeight="Bold"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,15">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="TaxSettings">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <CheckBox IsChecked="{Binding TaxEnabled}"
                             FontFamily="{DynamicResource BanglaFontFamily}"
                             Margin="0,0,0,10"
                             Style="{StaticResource MaterialDesignCheckBox}">
                        <CheckBox.Content>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="EnableTax">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </CheckBox.Content>
                    </CheckBox>
                    
                    <TextBlock FontSize="14"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              Margin="0,0,0,5"
                              Visibility="{Binding TaxEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="TaxRate">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,0,0"
                            Visibility="{Binding TaxEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Setter Property="materialDesign:HintAssist.Hint">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="TaxRateHint">
                                            <Binding Path="Language" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Command="{Binding ResetSettingsCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       FontFamily="{DynamicResource BanglaFontFamily}"
                       Margin="0,0,10,0"
                       Padding="20,10">
                    <Button.Content>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Reset">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.Content>
                </Button>
                
                <Button Command="{Binding SaveSettingsCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       FontFamily="{DynamicResource BanglaFontFamily}"
                       Padding="20,10">
                    <Button.Content>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Save">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>

