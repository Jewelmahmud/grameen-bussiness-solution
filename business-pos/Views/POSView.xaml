<UserControl x:Class="GrameenPOS.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:GrameenPOS.Views"
             x:Name="POSViewControl"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar with Settings Button -->
        <Border Grid.Row="0" 
               Background="{DynamicResource PrimaryGradientBrush}" 
               Padding="20,10"
               Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock FontSize="24" 
                          FontWeight="Bold"
                          FontFamily="{DynamicResource BanglaFontFamily}"
                          Foreground="White"
                          VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="AppName">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                
                <Button Grid.Column="1"
                       Command="{Binding SwitchLanguageCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       Foreground="White"
                       Width="60"
                       Height="60"
                       Padding="10"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center">
                    <Button.ToolTip>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Language">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <materialDesign:PackIcon Kind="Translate" />
                </Button>
                
                <Button Grid.Column="2"
                       Command="{Binding NavigateToSettingsCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       Foreground="White"
                       Width="60"
                       Height="60"
                       Padding="10"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center">
                    <Button.ToolTip>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Settings">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <materialDesign:PackIcon Kind="Settings" />
                </Button>
                
                <Button Grid.Column="3"
                       Command="{Binding LogoutCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       Foreground="White"
                       Width="60"
                       Height="60"
                       Padding="10"
                       VerticalAlignment="Center">
                    <Button.ToolTip>
                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Logout">
                            <Binding Path="Language" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <materialDesign:PackIcon Kind="Logout" />
                </Button>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Products Section (75% of left area) -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Search Bar -->
                <Grid Grid.Row="0" Margin="20">
                    <TextBox x:Name="SearchTextBox"
                            materialDesign:HintAssist.Hint="{Binding SearchPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            FontSize="16"
                            FontFamily="{DynamicResource BanglaFontFamily}"
                            Height="48"
                            Padding="15,14,15,14"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:HintAssist.FloatingScale="0.85"
                            materialDesign:HintAssist.FloatingOffset="0,-24"
                            GotFocus="SearchTextBox_GotFocus"/>
                </Grid>
                
                <!-- Product Grid -->
                <ScrollViewer Grid.Row="1" Margin="20,10,20,10">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                                       BorderThickness="2" 
                                       Margin="8"
                                       CornerRadius="8"
                                       Background="White"
                                       materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                       MinHeight="180">
                                    <Button Click="ProductButton_Click"
                                           Style="{StaticResource MaterialDesignFlatButton}"
                                           Padding="0"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           MinHeight="180">
                                        <StackPanel Margin="10">
                                            <!-- Product Name - Full Height -->
                                            <TextBlock Text="{Binding Name}" 
                                                      FontSize="18" 
                                                      FontWeight="Bold"
                                                      FontFamily="{DynamicResource BanglaFontFamily}"
                                                      Foreground="#212121"
                                                      TextWrapping="Wrap"
                                                      HorizontalAlignment="Center"
                                                      TextAlignment="Center"
                                                      Margin="0,0,0,12"
                                                      MaxHeight="80"
                                                      LineHeight="24"
                                                      TextTrimming="None">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#212121"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            
                                            <!-- Price -->
                                            <TextBlock HorizontalAlignment="Center"
                                                      Margin="0,0,0,12"
                                                      FontSize="22">
                                                <Run Text="৳" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Run Text="{Binding Price, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </TextBlock>
                                            
                                            <!-- Divider -->
                                            <Border Height="1" 
                                                   Background="{DynamicResource BorderLightBrush}" 
                                                   Margin="0,0,0,10"
                                                   HorizontalAlignment="Stretch"/>
                                            
                                            <!-- Product Metadata -->
                                            <StackPanel>
                                                <!-- Barcode -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                              FontFamily="{DynamicResource BanglaFontFamily}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              Margin="0,0,5,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Barcode">
                                                                <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Barcode}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              FontWeight="SemiBold"/>
                                                </Grid>
                                                
                                                <!-- Stock -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                              FontFamily="{DynamicResource BanglaFontFamily}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              Margin="0,0,5,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Stock">
                                                                <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding Stock}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Stock}" Value="0">
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                
                                                <!-- Image URL (if available) -->
                                                <Grid Margin="0,0,0,0" 
                                                     Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                              FontFamily="{DynamicResource BanglaFontFamily}"
                                                              FontSize="10"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              Margin="0,0,5,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Image">
                                                                <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                              Text="{Binding ImageUrl}"
                                                              FontSize="9"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- Virtual Keyboard (25% of left area, between products and cart) -->
        <Border Grid.Column="1" 
               BorderBrush="{DynamicResource BorderLightBrush}" 
               BorderThickness="0,0,1,0"
               Background="{DynamicResource BackgroundLightBrush}"
               Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Keyboard Header -->
                <Border Grid.Row="0"
                       Background="{DynamicResource PrimaryGradientBrush}"
                       Padding="10,8"
                       Margin="0,0,0,10"
                       CornerRadius="3">
                    <TextBlock FontFamily="{DynamicResource BanglaFontFamily}"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="White"
                              HorizontalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Keyboard">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>
                
                <!-- Keyboard Content -->
                <views:VirtualKeyboard x:Name="VirtualKeyboardControl" Grid.Row="1"/>
            </Grid>
        </Border>
        
        <!-- Cart Section -->
        <Border Grid.Column="2" Background="{DynamicResource BackgroundLightBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Cart Header -->
                <Grid Grid.Row="0" Margin="20,20,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                              FontSize="24"
                              FontWeight="Bold"
                              FontFamily="{DynamicResource BanglaFontFamily}"
                              VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Cart">
                                <Binding Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <Button Grid.Column="1"
                           Command="{Binding ClearCartCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           FontFamily="{DynamicResource BanglaFontFamily}"
                           FontSize="14"
                           Padding="15,8"
                           ToolTip="কার্ট খালি করুন"
                           Background="{DynamicResource ResetButtonBrush}"
                           Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="ClearCart">
                                        <Binding Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Cart Items -->
                <ScrollViewer Grid.Row="1" Margin="20,0">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                                       BorderThickness="0,0,0,1" 
                                       Padding="10"
                                       Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Product.Name}" 
                                                      FontSize="14" 
                                                      FontWeight="SemiBold"
                                                      FontFamily="{DynamicResource BanglaFontFamily}"
                                                      Foreground="Black"/>
                                            <TextBlock FontFamily="{DynamicResource BanglaFontFamily}">
                                                <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                <Run Text=" x "/>
                                                <Run Text="৳"/>
                                                <Run Text="{Binding Product.Price, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                <Run Text=" = "/>
                                                <Run Text="৳"/>
                                                <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Quantity Decrease Button -->
                                        <Button Grid.Column="1"
                                               Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               materialDesign:ButtonAssist.CornerRadius="20"
                                               Width="40"
                                               Height="40"
                                               Padding="5"
                                               Margin="0,0,5,0">
                                                    <Button.ToolTip>
                                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Decrease">
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="Minus" FontSize="20"/>
                                        </Button>
                                        
                                        <!-- Quantity Display -->
                                        <TextBlock Grid.Column="2"
                                                  Text="{Binding Quantity, Mode=OneWay}"
                                                  FontSize="18"
                                                  FontWeight="Bold"
                                                  FontFamily="{DynamicResource BanglaFontFamily}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  MinWidth="30"
                                                  Margin="0,0,5,0"/>
                                        
                                        <!-- Quantity Increase Button -->
                                        <Button Grid.Column="3"
                                               Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               materialDesign:ButtonAssist.CornerRadius="20"
                                               Width="40"
                                               Height="40"
                                               Padding="5"
                                               Margin="0,0,5,0">
                                                    <Button.ToolTip>
                                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Increase">
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="Plus" FontSize="20"/>
                                        </Button>
                                        
                                        <!-- Remove Button -->
                                        <Button Grid.Column="4"
                                               Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignIconButton}"
                                               materialDesign:ButtonAssist.CornerRadius="20"
                                               Width="40"
                                               Height="40"
                                               Padding="5">
                                                    <Button.ToolTip>
                                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Remove">
                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="Delete" FontSize="20"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Totals -->
                <Border Grid.Row="2" 
                       BorderBrush="{DynamicResource BorderLightBrush}" 
                       BorderThickness="0,1,0,0"
                       Padding="20"
                       Background="White">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{DynamicResource BanglaFontFamily}"
                                      Grid.Column="0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Subtotal">
                                        <Binding Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" 
                                      HorizontalAlignment="Right"
                                      FontWeight="SemiBold">
                                <Run Text="৳"/>
                                <Run Text="{Binding Subtotal, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>
                        
                        <!-- Discount Section -->
                        <Grid Margin="0,0,0,5" Visibility="{Binding Discount, Converter={StaticResource DecimalToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{DynamicResource BanglaFontFamily}"
                                      Grid.Column="0"
                                      Foreground="Green">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Discount">
                                        <Binding Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" 
                                      HorizontalAlignment="Right"
                                      Foreground="Green"
                                      FontWeight="SemiBold">
                                <Run Text="-৳"/>
                                <Run Text="{Binding Discount, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>
                        
                        <!-- Discount Input -->
                        <Border BorderBrush="{DynamicResource BorderLightBrush}" 
                               BorderThickness="1" 
                               CornerRadius="3"
                               Padding="10"
                               Margin="0,0,0,5"
                               Background="{DynamicResource BackgroundLightBrush}">
                            <StackPanel>
                                <TextBlock FontFamily="{DynamicResource BanglaFontFamily}"
                                          FontSize="12"
                                          Margin="0,0,0,10">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="ApplyDiscount">
                                            <Binding Path="Language" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                
                                <!-- Discount Input Row: Dropdown (Left) | Input (Right) | Apply Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" MaxWidth="200"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Discount Type Dropdown (Left) -->
                                    <ComboBox Grid.Column="0"
                                             SelectedValue="{Binding DiscountType}"
                                             SelectedValuePath="Tag"
                                             Margin="0,0,10,0"
                                             FontFamily="{DynamicResource BanglaFontFamily}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch">
                                        <ComboBoxItem Tag="None">
                                            <ComboBoxItem.Content>
                                                <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="NoDiscount">
                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </ComboBoxItem.Content>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Percentage">
                                            <ComboBoxItem.Content>
                                                <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Percentage">
                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </ComboBoxItem.Content>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Fixed">
                                            <ComboBoxItem.Content>
                                                <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="FixedAmount">
                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </ComboBoxItem.Content>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    
                                    <!-- Discount Value Input (Right) -->
                                    <TextBox x:Name="DiscountTextBox"
                                            Grid.Column="1"
                                            Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            VerticalAlignment="Center"
                                            Height="50"
                                            FontSize="18"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Stretch"
                                            Visibility="{Binding DiscountType, Converter={StaticResource DiscountTypeToVisibilityConverter}}"
                                            materialDesign:HintAssist.Hint="{Binding DiscountType, Converter={StaticResource DiscountTypeHintConverter}}"
                                            GotFocus="DiscountTextBox_GotFocus"/>
                                    
                                    <!-- Apply Button -->
                                    <Button Grid.Column="2"
                                           Command="{Binding ApplyDiscountCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           FontFamily="{DynamicResource BanglaFontFamily}"
                                           FontSize="14"
                                           Padding="15,10"
                                           MinWidth="80"
                                           Height="50"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Visibility="{Binding DiscountType, Converter={StaticResource DiscountTypeToVisibilityConverter}}">
                                        <Button.Content>
                                            <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Apply">
                                                <Binding Path="Language" />
                                            </MultiBinding>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                                
                                <!-- Clear Discount Button -->
                                <Button Command="{Binding ClearDiscountCommand}"
                                       Style="{StaticResource MaterialDesignFlatButton}"
                                       FontFamily="{DynamicResource BanglaFontFamily}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding DiscountType, Converter={StaticResource DiscountTypeToVisibilityConverter}}">
                                    <Button.Content>
                                        <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="RemoveDiscount">
                                            <Binding Path="Language" />
                                        </MultiBinding>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Border>
                        
                        <Grid Margin="0,0,0,5" Visibility="{Binding Tax, Converter={StaticResource DecimalToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{DynamicResource BanglaFontFamily}"
                                      Grid.Column="0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Tax">
                                        <Binding Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" 
                                      HorizontalAlignment="Right">
                                <Run Text="৳"/>
                                <Run Text="{Binding Tax, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" 
                                      FontWeight="Bold"
                                      FontFamily="{DynamicResource BanglaFontFamily}"
                                      Grid.Column="0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizationConverter}" ConverterParameter="Total">
                                        <Binding Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="1" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      HorizontalAlignment="Right"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}">
                                <Run Text="৳"/>
                                <Run Text="{Binding Total, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Payment Buttons -->
                <StackPanel Grid.Row="3" Margin="20">
                    <Button Command="{Binding ProcessCashPaymentCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Height="70"
                           FontSize="20"
                           FontWeight="Bold"
                           FontFamily="{DynamicResource BanglaFontFamily}"
                           Background="{DynamicResource ButtonDarkBlueBrush}"
                           Foreground="White"
                           Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cash" 
                                                    Width="28" 
                                                    Height="28" 
                                                    VerticalAlignment="Center"
