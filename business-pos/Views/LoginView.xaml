<UserControl x:Class="GrameenPOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <!-- Background Image -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Source="{Binding BackgroundImageSource}"/>
        
        <!-- Gradient Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop>
                        <GradientStop.Color>
                            <Binding Path="OverlayColorStart"/>
                        </GradientStop.Color>
                        <GradientStop.Offset>0</GradientStop.Offset>
                    </GradientStop>
                    <GradientStop>
                        <GradientStop.Color>
                            <Binding Path="OverlayColorEnd"/>
                        </GradientStop.Color>
                        <GradientStop.Offset>1</GradientStop.Offset>
                    </GradientStop>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Opacity>
                <Binding Path="OverlayOpacity"/>
            </Rectangle.Opacity>
        </Rectangle>
        
        <!-- Login Form -->
        <Border Background="White" 
                CornerRadius="8" 
                Padding="40"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                materialDesign:ShadowAssist.ShadowDepth="Depth5">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Run Text="গ্রামীণ" 
                         FontSize="32" 
                         FontWeight="Bold"
                         FontFamily="{DynamicResource BanglaFontFamily}"
                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <Run Text=" POS" 
                         FontSize="32" 
                         FontWeight="Bold"
                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </TextBlock>
                
                <TextBox materialDesign:HintAssist.Hint="ইমেইল"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Margin="0,0,0,20"
                        FontSize="16"
                        FontFamily="{DynamicResource BanglaFontFamily}"/>
                
                <!-- Password + inline show/hide (suffix inside the outlined field) -->
                <Grid Margin="0,0,0,20">
                    <PasswordBox x:Name="PasswordBox"
                                materialDesign:HintAssist.Hint="পাসওয়ার্ড"
                                materialDesign:TextFieldAssist.TextBoxViewMargin="0,0,44,0"
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                FontSize="16"
                                FontFamily="{DynamicResource BanglaFontFamily}"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                Visibility="Visible"/>

                    <TextBox x:Name="PasswordTextBox"
                             materialDesign:HintAssist.Hint="পাসওয়ার্ড"
                             materialDesign:TextFieldAssist.TextBoxViewMargin="0,0,44,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="16"
                             FontFamily="{DynamicResource BanglaFontFamily}"
                             TextChanged="PasswordTextBox_TextChanged"
                             Visibility="Collapsed"/>

                    <ToggleButton x:Name="ShowPasswordToggle"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"
                                  Width="40"
                                  Height="40"
                                  Panel.ZIndex="1"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="পাসওয়ার্ড দেখান/লুকান"
                                  Checked="ShowPasswordToggle_Checked"
                                  Unchecked="ShowPasswordToggle_Unchecked">
                        <materialDesign:PackIcon x:Name="PasswordVisibilityIcon"
                                                 Kind="Eye"
                                                 Width="22"
                                                 Height="22"
                                                 Foreground="{DynamicResource MaterialDesignBody}"/>
                    </ToggleButton>
                </Grid>
                
                <CheckBox Content="আমাকে মনে রাখুন"
                         IsChecked="{Binding RememberMe}"
                         Margin="0,0,0,20"
                         FontFamily="{DynamicResource BanglaFontFamily}"
                         Style="{StaticResource MaterialDesignCheckBox}"/>
                
                <TextBlock Text="{Binding ErrorMessage}"
                          Foreground="Red"
                          TextWrapping="Wrap"
                          FontFamily="{DynamicResource BanglaFontFamily}"
                          Margin="0,0,0,20"
                          Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <Button Content="লগইন"
                       Command="{Binding LoginCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       HorizontalAlignment="Stretch"
                       Height="45"
                       FontSize="16"
                       FontFamily="{DynamicResource BanglaFontFamily}"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                
                <ProgressBar IsIndeterminate="True"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,10,0,0"
                            Height="4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

