# Grameen Bazaar default company context (optional)
# When GRAMEEN_BAZAAR_ATTACH_COMPANY_ID=true and GRAMEEN_BAZAAR_ID is set,
# backend will automatically inject this company_id into every request body.
GRAMEEN_BAZAAR_ID=db9a31a2-d723-42aa-9ae3-0940939ceba5
GRAMEEN_BAZAAR_ATTACH_COMPANY_ID=false

# Application Environment
NODE_ENV=development
PORT=3040

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
# Host port for docker-compose (container listens on 5432). On Windows, avoid ~5433–6032 (Hyper-V exclusions); e.g. 6040.
POSTGRES_PORT=6040
POSTGRES_USER=dokan_user
POSTGRES_PASSWORD=dokan_password
POSTGRES_DB=dokan_db

# Database Connection URL (for ORMs like Prisma, TypeORM)
DATABASE_URL=postgresql://dokan_user:dokan_password@postgres:5432/dokan_db

# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@dokan.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Application Secrets (Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# API Configuration
API_PREFIX=/api/v1

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://grameenbusiness.vercel.app

# Auth Server: STAGING | LOCAL | PROD
AUTH_SERVER=STAGING
AUTH_SERVER_URL_STAGING=https://auth.grameenbazaar.com
AUTH_SERVER_URL_PROD=https://auth.grameenbazaar.com
AUTH_SERVER_URL_LOCAL=http://localhost:5001
# Set true only if auth server uses self-signed cert
# AUTH_SERVER_INSECURE_SSL=false

# SSLCommerz Payment Gateway Configuration
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3002

# Logging
LOG_LEVEL=debug

# Image upload: driver = local | s3 (s3 for Amazon S3 or S3-compatible service)
UPLOAD_DRIVER=local
# Local disk path for storing uploads (e.g. C:\Users\getje\Pictures\grameenimages or /app/uploads in container)
UPLOAD_LOCAL_PATH=C:\Users\getje\Pictures\grameenimages
# Max file size in bytes for image uploads (default 5MB)
UPLOAD_MAX_FILE_SIZE=5242880

# S3 / S3-compatible (used when UPLOAD_DRIVER=s3)
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT= (optional, for MinIO or custom S3-compatible; leave empty for AWS)
# S3_PUBLIC_BASE_URL= (optional base URL for public read; if not set, uses bucket URL)

